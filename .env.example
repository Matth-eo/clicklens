# Use a dedicated PostgreSQL database. Never reuse Tracebit credentials.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/clicklens?schema=public"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-new-random-secret-at-least-32-characters"
# Public origin used in copied links; HTTPS in production.
APP_URL="http://localhost:3000"
